# Plaud MCP Server configuration.
#
# Choose ONE of the three auth modes below.
# The local runtime helper supports both Docker Desktop and Podman on macOS:
#   bash scripts/container-runtime.sh docker up
#   bash scripts/container-runtime.sh podman up

# --- Mode 1: Auto-refresh (recommended for users with a Plaud password) ---
# The container will log in automatically and refresh the token before expiry.
PLAUD_AUTO_REFRESH=true
PLAUD_EMAIL=you@example.com
PLAUD_PASSWORD=your_plaud_password
PLAUD_TOKEN_FILE=/app/data/plaud.token
PLAUD_DEVICE_ID=your_device_uuid_here

# --- Mode 2: SSO browser auth ---
# Run `python scripts/setup-auth.py` once to obtain a token (lasts ~10 months).
# The script writes the token to ./data/plaud.token (mounted into the container).
# Required env vars in this mode:
#   PLAUD_TOKEN_FILE=/app/data/plaud.token
#   PLAUD_DEVICE_ID=...

# --- Mode 3: Manual token (legacy) ---
# Extract the token via `python scripts/get-token.py` and paste here.
# PLAUD_TOKEN=your_plaud_jwt_token_here
# PLAUD_DEVICE_ID=your_device_uuid_here
